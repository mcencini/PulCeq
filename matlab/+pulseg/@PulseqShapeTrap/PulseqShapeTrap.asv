classdef PulseqShapeTrap
    %PULSEQSHAPETRAP Represents a trapezoidal shape.

    properties
        riseTime int32
        flatTime int32
        fallTime int32
    end

    methods
        function obj = PulseqShapeTrap(riseTime, flatTime, fallTime)
            if nargin > 0
                obj.riseTime = riseTime;
                obj.flatTime = flatTime;
                obj.fallTime = fallTime;
            end
        end

        function bytes = to_bytes(obj, byteswap)
            % Serialize PulseqShapeTrap to bytes.
            %
            % Parameters
            % ----------
            % byteswap : logical, optional
            %     Whether to byteswap (True -> big-endian, False -> little-endian), default is False
            %
            % Returns
            % -------
            % bytes : uint8 array
            %     Serialized byte representation of the object.

            if nargin < 2
                byteswap = false;
            end
            
            % Enforce precision
            obj_riseTime = int32(obj.riseTime);
            obj_flatTime = int32(obj.flatTime);
            obj_fallTime = int32(obj.fallTime);

            % Convert to bytes
            b_riseTime = typecast(obj_riseTime, 'uint8');
            b_flatTime = typecast(obj_flatTime, 'uint8');
            b_fallTime = typecast(obj_fallTime, 'uint8');

            % Perform byteswap if requested
            if byteswap
                b_riseTime = swapbytes(b_riseTime);
                b_flatTime = swapbytes(b_flatTime);
                b_fallTime = swapbytes(b_fallTime);
            end

            % Concatenate
            bytes = [b_riseTime, b_flatTime, b_fallTime];
        end
    end

    methods (Static)
        function obj = from_bytes(data, byteswap)
            % Deserialize PulseqShapeTrap from bytes.
            %
            % Parameters
            % ----------
            % data : uint8 array
            %     Byte data to deserialize.
            % byteswap : logical, optional
            %     Whether to byteswap (True -> big-endian, False -> little-endian), default is False
            %
            % Returns
            % -------
            % obj : PulseqShapeTrap
            %     Deserialized object.

            if nargin < 2
                byteswap = false;
            end
            
            % Extract values
            b_riseTime = data(1:4);
            b_flatTime = data(5:8);
            b_fallTime = data(9:12);
            
            % Perform byteswap if requested
            if byteswap
                b_riseTime = swapbytes(b_riseTime);
                b_flatTime = swapbytes(b_flatTime);
                b_fallTime = swapbytes(b_fallTime);
            end

            % Convert to int
            riseTime = typecast(b_riseTime, 'int32');
            flatTime = typecast(b_flatTime, 'int32');
            fallTime = typecast(b_fallTime, 'int32');

            % Return object
            obj = pulseg.PulseqShapeTrap(riseTime, flatTime, fallTime);
        end
    end
end
